APP_ENV=prod
APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./jarvis_crm.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Cifra o que e sensivel em repouso (o texto das buscas registradas pelo
# Sentinela). O INSTALAR.bat gera uma chave aleatoria aqui. SEM ELA O APP NAO
# SOBE — de proposito: melhor recusar a subir do que gravar em texto claro.
# Gerar a mao:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Optional: enable periodic disk backups (JSON envelope per workspace).
# Leave JARVIS_BACKUP_DIR empty to disable.
JARVIS_BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=60
