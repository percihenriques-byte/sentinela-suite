{
  "manifest_version": 3,
  "name": "Sentinela — Filtro e Supervisão",
  "version": "1.0.0",
  "description": "Analisa com IA local (sem internet) o que a criança vê — a busca E o conteúdo de texto da página — e bloqueia o impróprio, registrando a atividade para o responsável.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["classificador.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinela — Supervisão"
  }
}
